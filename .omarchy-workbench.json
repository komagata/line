{
  "schemaVersion": 1,
  "pluginPath": ".",
  "checks": [
    {
      "name": "project-tests",
      "argv": [
        "./tests/run"
      ],
      "timeoutSeconds": 900
    }
  ],
  "environment": [
    {
      "name": "go",
      "argv": [
        "go",
        "version"
      ],
      "required": true
    },
    {
      "name": "python3",
      "argv": [
        "python3",
        "--version"
      ],
      "required": true
    },
    {
      "name": "qmltestrunner",
      "argv": [
        "qmltestrunner",
        "-help"
      ],
      "required": true
    },
    {
      "name": "omarchy",
      "argv": [
        "omarchy",
        "--version"
      ],
      "required": false
    }
  ],
  "workflows": [
    {
      "name": "portable-tests",
      "capability": "validate",
      "argv": [
        "./tests/run"
      ],
      "timeoutSeconds": 900,
      "requires": []
    }
  ]
}
