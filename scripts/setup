#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
command -v python3 >/dev/null || { printf 'setup: required tool missing: python3\n' >&2; exit 1; }
# Resolve Go before Python/mise can reorder PATH.
export GO_BIN="$(command -v go || true)"
exec python3 -B scripts/setup.py "$@"
